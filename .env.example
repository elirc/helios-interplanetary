DATABASE_URL=postgresql://helios:helios_local_only@127.0.0.1:5438/helios
TEST_DATABASE_URL=postgresql://helios:helios_local_only@127.0.0.1:5438/helios_test
APP_ORIGIN=http://127.0.0.1:3000
# Explicit local-only demo identity. Do not enable on a public deployment.
DEMO_MODE=true
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Offline by default. Live calls require all three values and incur provider usage.
HELIOS_MODEL_PROVIDER=fixture
